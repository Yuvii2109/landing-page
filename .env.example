# NexG SMS gateway configuration for OTP flow
# Copy this file to .env locally and set real values.
# For Vercel, set these in Project Settings -> Environment Variables.

NEXG_USERNAME=
NEXG_PASSWORD=
NEXG_FROM=EDXSOL
NEXG_DLT_TEMPLATE_ID=
NEXG_DLT_PRINCIPAL_ENTITY_ID=
NEXG_DLT_TELEMARKETER_ID=

# Use {{SCHOOL}}/{{OTP}} to avoid dotenv $variable expansion.
NEXG_OTP_TEXT_TEMPLATE=Dear {{SCHOOL}}, Your one time password (OTP) is {{OTP}} Do not disclose it to anyone. Team Spark Olympiads(EDXSO)

# Supabase configuration for backend persistence.
# Use service role key only on server-side code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
